{
  "actionLists": {
    "invertCard": [
            ["INVERT_CARD"]
            ],
    "damageCard": [
            ["COND",
                ["EQUAL", "$ACTIVE_CARD.rotation", 0],
                [
                    ["LOG", "$ALIAS_N", " damaged ", "$ACTIVE_FACE.name", "."],
                    ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 90]    
                ],
                true,
                [
                    ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 0],
                    ["LOG", "$ALIAS_N", " undamaged ", "$ACTIVE_FACE.name", "."]
                ]
            ]
            ],
    "drawoneCard": [
            ["LOG", "$ALIAS_N", " drew 1 Card from Active Pile."],
            ["DRAW_ONE_CARD"]
        ],
    "drawstartingHand": [
            ["LOG", "$ALIAS_N", " drew starting hand of 8 Cards from Reserve."],
            ["DRAW_STARTING_HAND"]
        ],
    "sendusedtoReserve": [
            ["LOG", "$ALIAS_N", " sent Used Pile to Bottom of Reserve."],
            ["USED_TO_RESERVE"]
        ],
    "menuactivateEnergy": [
            ["ACTIVATE_ENERGY"]
        ],
    "menuPayEnergy": [
            ["PAY_ENERGY"]
        ],
    "menureservetoLost": [
            ["RESERVE_TO_LOST"]
        ],
    "menuactivetoLost": [
            ["ACTIVE_TO_LOST"]
        ],
    "menuusedtoLost": [
            ["USED_TO_LOST"]
        ],
    "flipCard": [
            ["LOG", "$ALIAS_N", " flipped ", "$ACTIVE_FACE.name", "."],
            ["FLIP"]
        ],
    "sendcardtolostPile": [
            ["SEND_TO_LOST"]
        ],
    "menusendcardtolostPile": [
            ["SEND_TO_LOST_CARD"]
        ],
    "sendcardtousedPile": [
            ["SEND_TO_USED"]
        ],
    "menusendcardtousedPile": [
            ["SEND_TO_USED_CARD"]
        ],
    "menulog_activation": [
            ["LOG_ACTIVATION"]
        ]
  }
}
{
  "automation": {
    "cards": {},
    "gameRules": {
        "stepTrigger": {
            "_comment": "Abstract class to trigger game step effects",
            "type": "trigger",
            "listenTo": ["/stepId"],
            "abstract": true
        },
        "phaseText": {
            "_comment": "Display fade text for each phase",
            "inheritFrom": "stepTrigger",
            "priority": 10,
            "condition": true,
            "then": ["COND",
                ["EQUAL", "$GAME.stepId", "1.0"],
                [["FADE_TEXT_GAME", "Activate Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Activate Energy up to Icons on your side of Locations +1. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "2.1"],
                [["FADE_TEXT_GAME", "Control Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Drain opponent for their energy icons at locations you control. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "3.1"],
                [["FADE_TEXT_GAME", "Deploy Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play cards from your hand. No limit. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.1"],
                [["FADE_TEXT_GAME", "Battle Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Pay 1 Energy to start battle at a Location you both have units/ships at. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.2"],
                [["FADE_TEXT_GAME", "Battle: Interrupts/Activated Abilities"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play interrupts/use activated abilities. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.3"],
                [["FADE_TEXT_GAME", "Battle Phase: Battle Destiny Step"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Both Players total Tactics. If total >4, draw Battle Destiny. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.4"],
                [["FADE_TEXT_GAME", "Battle: Interrupts/Activated Abilities"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play interrupts/use activated abilities. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.5"],
                [["FADE_TEXT_GAME", "Battle Phase: Attrition Step"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Both players cause attrition equal to Battle Destiny. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.6"],
                [["FADE_TEXT_GAME", "Battle: Interrupts/Activated Abilities"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play interrupts/use activated abilities. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.7"],
                [["FADE_TEXT_GAME", "Battle Phase: Power Step"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Both Players total power of Units/Ships at Location + Battle Destiny. Higher wins. Difference = Casualties. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.8"],
                [["FADE_TEXT_GAME", "Battle: Interrupts/Activated Abilities"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play interrupts/use activated abilities. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.9"],
                [["FADE_TEXT_GAME", "Battle Phase: Loss Step"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Losing Player loses Energy equal to Casualties. May reduce by damaging units/ships. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.10"],
                [["FADE_TEXT_GAME", "Battle: Interrupts/Activated Abilities"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Play interrupts/use activated abilities. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "4.11"],
                [["FADE_TEXT_GAME", "Battle Phase: End of Battle"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "All Damaged Cards to Lost Pile. Start another Battle at Step 4.1 or Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "5.1"],
                [["FADE_TEXT_GAME", "Move Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Pay 1 Energy to perform a Movement Action for ship/unit. May perform multiple moves. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "6.1"],
                [["FADE_TEXT_GAME", "Draw Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "Draw cards from Active Pile one at a time. No limit. Arrow-Down for Next."]],
                ["EQUAL", "$GAME.stepId", "7.1"],
                [["FADE_TEXT_GAME", "End of Turn Phase"],
                ["UPDATE_LAYOUT", "/layout/textBoxes/roundAdvancement/label", "End Turn. Hotkey E to move Used Pile to bottom of Reserve. Arrow-Down for Next."]]
            ]
        }
      },
    "postLoadActionList": [
      [
        "LOG",
        "{{$PLAYER_N}} loaded some cards."
      ]
    ],
    "postNewGameActionList": [
      ["LOG", "A new game was created."],
      ["PROMPT", "player1", "welcome1"],
      ["PROMPT", "player2", "welcome1"]
    ]
  }
}